# DeepSeek-R1 SGLang MLPerf build.
# Base image: rocm/sgl-dev:v0.5.15.post1-rocm720-mi35x-20260722
# Curated upstream PRs / local patches are applied on top of the base image
# in place via the apply_prs build step. See
# setup/build_scripts/dockerfiles/Dockerfile.mlperf_prs and
# setup/deepseek-r1/patches/prs/.
#
# sglang patches (applied in order):
#   0001 #29209  fused MLA concat_and_cache
#   0002 #29344  fused bf16 kv_b_proj split-cat (needs aiter 0002)
#   0003         mla-max-splits accuracy
#   0004 #31604  SGLANG_MLA_ABSORB_BF16 (keep MLA-absorb weights in BF16)
#   0005 #31611  BF16 MLA-absorb elementwise elimination
#   0006 #31370  fold padded-topk into fused shared-expert append+remap
#   0007 #28080  gate TBO dual-stream a2a to graph capture
#   0008 #31775  o_proj MXFP4 ASM a4w4. Opt-in: SGLANG_DSR_OPROJ_MXFP4_ASM=1.
#   0009         q_b_proj MXFP4 ASM a4w4 fast path. Opt-in:
#                ENABLE_DYNAMIC_MXFP4_QUANT_Q_B_PROJ=1 and ENABLE_Q_B_PROJ_MXFP4=1.
#   0010         decode-graph-preserving prefill admission control. Enable in the
#                run yaml: enable_decode_graph_preserving: True,
#                decode_graph_preserve_max_defer: 8.
# aiter patches:
#   0001 #3739   DSv3-MXFP4 E=33/topk8 fused-MoE shapes
#   0002 #3940   fused_gemm_a16w16_split_cat Triton kernel (used by sglang 0002)
#   0003 #3805   fmoe tune dedup
# mori: no patches for this base image (recompile step skipped).

# The legacy single-file sglang patch step is disabled; patches go through apply_prs.
export SGLANG_CUSTOM_PATCH=""
export SGLANG_LOCATION_DIR=""

# aiter is patched in place by apply_prs (no full reinstall / CK recompile needed).
export AITER_URL=""
export AITER_REV=""
export AITER_CUSTOM_PATCH=""
export CK_CUSTOM_PATCH=""

# Curated PR patch tree (relative to the setup/ build context) + GPU arch for mori.
export PRS_DIR="deepseek-r1/patches/prs"
export GPU_ARCH="gfx950"

export DOCKER_BASE_IMAGE=rocm/sgl-dev:v0.5.15.post1-rocm720-mi35x-20260722
export DOCKERFILE_MLPERF=Dockerfile.mlperf_sglang
export DOCKERFILE_SGLANG=Dockerfile.sglang_patch
export DOCKER_RESULT_IMAGE=rocm/mlperf-inference:v0.5.15.post1-rocm720-mi35x-20260722_prs

# Aiter kernel preload = GPU warmup: bakes the kernel cache into the image using
# the production runtime config (offline_mi355x), so fused MLA/kvb kernels, the
# mori-EP paths, shared-expert fusion and the decode CUDA-graph batch sizes are
# already compiled. Requires 8 GPUs and the model available at
# $PRELOAD_AITER_MODEL_DIR (mapped to /model/ in the container).
# Set to "" to skip the GPU warmup step (build without GPUs).
export PRELOAD_AITER_COMMAND_ARGS="--config-path deepseek-r1/ --config-name offline_mi355x --backend sglang"
#export PRELOAD_AITER_COMMAND_ARGS=""
