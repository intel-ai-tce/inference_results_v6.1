+        slot_id_safe = tl.where(valid, slot_id, 0)
+        block_id = slot_id_safe // block_size       # [BLOCK_TOKENS]
+        block_off = slot_id_safe % block_size       # [BLOCK_TOKENS]
+
+        head = tl.arange(0, NUM_KV_HEADS)           # [NUM_KV_HEADS]
