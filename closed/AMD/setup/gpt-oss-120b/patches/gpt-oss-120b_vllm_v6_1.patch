+        """Heuristic for choosing pa_v2's per-partition token count.
+        Fix this later with more sophisticated heuristic.
+        """
+        TARGET_GRID = 1024
+        BLK = rocm_aiter_ops.PA_V2_BLOCK_SIZE
+        grid_per_part = num_kv_heads * max(num_seqs, 1)
+        if grid_per_part <= 0:
+            return rocm_aiter_ops.PA_V2_DEFAULT_PARTITION
+        min_parts = max(1, TARGET_GRID // grid_per_part)
+        opt = max_seq_len // min_parts
+        opt = ((opt + BLK - 1) // BLK) * BLK
+        return max(rocm_aiter_ops.PA_V2_DEFAULT_PARTITION,
+                   min(opt, max(max_seq_len, BLK)))
