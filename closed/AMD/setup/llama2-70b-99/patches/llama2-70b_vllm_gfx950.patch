     return x_fp8, out_bs
 
 
+# MXFP4 block size is fixed by the OCP MX spec.
+MXFP4_QUANT_BLOCK_SIZE = 32
+
+
+def _rocm_aiter_act_mul_and_mxfp4_group_quant_impl(
+    x: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    M, N = x.shape
+    if M * N >= 2**31:
+        from aiter import per_1x32_f4_quant_hip, silu_and_mul
+
+        act = torch.empty(M, N // 2, dtype=x.dtype, device=x.device)
+        silu_and_mul(act, x)
+        return per_1x32_f4_quant_hip(act, shuffle=True)
+
+    from aiter.ops.triton.activation import act_mul_and_mxfp4_quant
+
+    return act_mul_and_mxfp4_quant(x, activation="silu", shuffle=True)
+
+
+def _rocm_aiter_act_mul_and_mxfp4_group_quant_fake(
+    x: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    M, N = x.shape
+    assert N % 4 == 0
+    N_half = N // 2
+    x_fp4 = torch.empty((M, N_half // 2), dtype=torch.uint8, device=x.device)
+    scale_n_valid = (N_half + MXFP4_QUANT_BLOCK_SIZE - 1) // MXFP4_QUANT_BLOCK_SIZE
+    # shuffle=True pads scales: M -> mult of 256, N -> mult of 8.
+    scale_m = (M + 255) // 256 * 256
+    scale_n = (scale_n_valid + 7) // 8 * 8
+    out_bs = torch.empty((scale_m, scale_n), dtype=torch.uint8, device=x.device)
+    return x_fp4, out_bs
+
+
