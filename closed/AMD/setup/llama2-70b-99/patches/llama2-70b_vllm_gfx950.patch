+class AiterSiluMulMxfp4GemmDynamicQuantPattern(VllmPatternReplacement):
+
+    FUSED_ACT_QUANT_OP = rocm_aiter_ops.get_act_mul_fused_mxfp4_group_quant_op()
+
+    def __init__(self) -> None:
+        self.silu_and_mul_matcher = MatcherSiluAndMul(match_rocm_aiter=True)
+        config = get_current_vllm_config()
+        self.out_dtype = (
+            config.model_config.dtype
+            if config.model_config is not None
+            else torch.bfloat16
+        )
+        self.device = (
+            config.device_config.device
+            if config.device_config is not None
+            else torch.device("cuda")
+        )
+        self.asm_gemm = rocm_aiter_ops.is_asm_fp4_gemm_dynamic_quant_enabled()
+        self.gemm_op = torch.ops.vllm.gemm_with_dynamic_quant.default
+
+    def get_inputs(self) -> list[torch.Tensor]:
+        input = torch.empty(4, 64, dtype=self.out_dtype, device=self.device)
+        weight = torch.empty(32, 16, dtype=torch.uint8, device=self.device)
+        weight_scale = torch.empty(32, 1, dtype=torch.uint8, device=self.device)
+        return [input, weight, weight_scale]
+
+    @property
+    def pattern(self):
+        def _pattern(
+            input: torch.Tensor,
+            weight: torch.Tensor,
+            weight_scale: torch.Tensor,
+        ) -> torch.Tensor:
+            silu_out = self.silu_and_mul_matcher(input)
+            return self.gemm_op(
+                silu_out,
+                weight,
+                weight_scale,
+                self.asm_gemm,
+                self.out_dtype,
+            )
+
+        return _pattern
+
+    @property
+    def replacement(self):
+        def _replacement(
+            input: torch.Tensor,
+            weight: torch.Tensor,
+            weight_scale: torch.Tensor,
+        ) -> torch.Tensor:
+            x_q, x_s = self.FUSED_ACT_QUANT_OP(input)
+            return self.gemm_op(
+                x_q,
+                weight,
+                weight_scale,
+                self.asm_gemm,
+                self.out_dtype,
+                x_s,
+            )
+
+        return _replacement
+
+
