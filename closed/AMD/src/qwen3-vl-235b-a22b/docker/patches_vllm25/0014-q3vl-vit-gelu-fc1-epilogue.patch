     def forward(self, x: torch.Tensor):
+        # Q3VL fusion #6: fold ViT MLP GELU into the fc1 GEMM epilogue via hipBLASLt
+        # (torch._addmm_activation) -- one kernel instead of matmul + separate gelu.
+        # use_gelu=True is the tanh approximation = the model intended gelu_pytorch_tanh.
+        if _Q3VL_FUSE_VIT_GELU_FC1 and getattr(self.linear_fc1, "bias", None) is not None:
