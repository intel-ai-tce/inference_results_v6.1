+    dim3 block_dim(WARP_SIZE, WARPS_PER_TB);
+
+    if(need_renorm)
+    {
+        topkGatingSoftmaxWithMesh<DTYPE, VPT, EXPERTS, WARPS_PER_TB, BYTES_PER_LDG, true, MeshType>
+            <<<num_blocks, block_dim, 0, stream>>>(input,
+                                                   nullptr,
+                                                   output,
+                                                   num_rows,
+                                                   p_expert_mesh,
+                                                   mesh_stride,
+                                                   k,
+                                                   start_expert,
+                                                   end_expert,
+                                                   output_stride,
+                                                   input_stride);
+    }
+    else
+    {
+        topkGatingSoftmaxWithMesh<DTYPE, VPT, EXPERTS, WARPS_PER_TB, BYTES_PER_LDG, false, MeshType>
+            <<<num_blocks, block_dim, 0, stream>>>(input,
+                                                   nullptr,
+                                                   output,
+                                                   num_rows,
+                                                   p_expert_mesh,
+                                                   mesh_stride,
+                                                   k,
+                                                   start_expert,
+                                                   end_expert,
+                                                   output_stride,
+                                                   input_stride);
+    }
+}
+
+// Dispatch the fused softmax over the (runtime) power-of-2 expert count. MeshType is
+// uint8_t (LARGE path). Returns false if the expert count is not instantiated
+// (caller must have fenced this out).
+template <typename DTYPE>
+inline bool launchFusedSoftmaxWithMesh(const void* p_gating,
+                                       float* p_weights,
+                                       void* p_ws,
+                                       int num_experts,
+                                       int mesh_stride,
+                                       int num_rows,
+                                       int topk,
+                                       bool need_renorm,
+                                       hipStream_t stream)
+{
+    const DTYPE* g    = reinterpret_cast<const DTYPE*>(p_gating);
+    uint8_t* mesh     = reinterpret_cast<uint8_t*>(p_ws);
+    const int in_str  = num_experts; // gating is contiguous [tokens, num_experts]
+    const int out_str = topk;        // topk_weights is contiguous [tokens, topk]
+#define OPUS_FUSED_SOFTMAX_CASE(EXP)                                                        \
+    case EXP:                                                                               \
+        launchTopkGatingSoftmaxWithMesh<DTYPE, EXP, 8, uint8_t>(g,                          \
+                                                               p_weights,                  \
+                                                               mesh,                       \
+                                                               mesh_stride,                \
+                                                               num_rows,                   \
+                                                               topk,                       \
+                                                               0,                          \
+                                                               num_experts,                \
+                                                               out_str,                    \
+                                                               in_str,                     \
+                                                               need_renorm,                \
+                                                               stream);                    \
+        return true;
+    switch(num_experts)
+    {
+        OPUS_FUSED_SOFTMAX_CASE(16)
+        OPUS_FUSED_SOFTMAX_CASE(32)
+        OPUS_FUSED_SOFTMAX_CASE(64)
+        OPUS_FUSED_SOFTMAX_CASE(128)
+        OPUS_FUSED_SOFTMAX_CASE(256)
+    default: return false;
+    }
+#undef OPUS_FUSED_SOFTMAX_CASE
+}
