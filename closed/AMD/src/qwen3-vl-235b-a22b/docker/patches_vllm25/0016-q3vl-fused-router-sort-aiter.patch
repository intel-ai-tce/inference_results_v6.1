+// Fusion campaign 2 - #3 (Alt C): fused router-softmax + opus sort.
+// Launch sequence: maybe_clear_workspace -> topkGatingSoftmaxWithMesh (row-parallel)
+// -> P1 -> P23, reusing the LARGE uint8-mesh phases verbatim. P0_v1 is skipped (the
+// fused softmax writes the mesh directly). Returns -1 (caller falls back to baseline)
+// for ANY config outside the fenced LARGE path.
+inline float moe_sorting_opus_fused(moe_sorting_opus_trait t,
+                                    moe_sorting_opus_args a,
+                                    const std::string& gating_dtype,
+                                    aiter::stream_config s)
+{
+    // ---- FENCE (PR-review BLOCKER 1). Anything else -> baseline. ----
+    if(!(t.weight_type == "fp32" && t.index_type == "i32"))
+        return -1;
+    if(t.local_expert_masking)
+        return -1;
+    if(a.p_local_tokens != nullptr)
+        return -1;
+    if(a.p_local_topk_ids != nullptr)
+        return -1;
+    if(a.tokens < 2048) // LARGE path only; SMALL/P0_v2 is incompatible
+        return -1;
+    const bool pow2 = a.num_experts > 0 && ((a.num_experts & (a.num_experts - 1)) == 0);
+    if(!pow2)
+        return -1;
+    const int ws =
+        moe_sorting_opus_get_workspace_size(a.tokens, a.num_experts, a.topk, t.dispatch_policy);
+    if(ws <= 0) // oneshot path has no workspace/mesh
+        return -1;
+    const int mesh_byte = aiter::impl::moe_sorting_mesh_byte_size(a.tokens, a.num_experts, a.topk);
+    if(mesh_byte != 1) // MeshType uint8_t only (PR-review MAJOR 3)
+        return -1;
+    if(aiter::impl::moe_sorting_get_smem_size_p23(a.num_experts, false) > opus::get_smem_size())
+        return -1;
+    if(!(gating_dtype == "bf16" || gating_dtype == "fp16" || gating_dtype == "fp32"))
+        return -1;
+
+    using ms_index_t     = opus::index_t;
+    using ms_weight_type = float;
+    bool is_local_token  = false; // fenced out above
+
+    auto maybe_clear_workspace = [=](const aiter::stream_config& s_) {
+        if(t.clear_workspace_inside_api)
+        {
+            auto k = OPUS_MOR_SORTING_CLEAR_WS_DISPATCH_(false, 1024, 1);
+            k(s_);
+        }
+    };
+
+    const int mesh_stride = aiter::impl::moe_sorting_mp_mesh_stride(a.tokens);
+    const int num_rows    = a.tokens;
+    const int topk        = a.topk;
+
+    auto fused_softmax = [=](const aiter::stream_config& s_) {
+        hipStream_t st = s_.stream_id_;
+        bool ok        = false;
+        if(gating_dtype == "bf16")
+            ok = aiter::launchFusedSoftmaxWithMesh<opus::bf16_t>(
+                a.p_gating, reinterpret_cast<float*>(const_cast<void*>(a.p_weights)), a.p_ws,
+                a.num_experts,
+                mesh_stride, num_rows, topk, a.need_renorm, st);
+        else if(gating_dtype == "fp16")
+            ok = aiter::launchFusedSoftmaxWithMesh<opus::fp16_t>(
+                a.p_gating, reinterpret_cast<float*>(const_cast<void*>(a.p_weights)), a.p_ws,
+                a.num_experts,
+                mesh_stride, num_rows, topk, a.need_renorm, st);
+        else // fp32
+            ok = aiter::launchFusedSoftmaxWithMesh<float>(
+                a.p_gating, reinterpret_cast<float*>(const_cast<void*>(a.p_weights)), a.p_ws,
+                a.num_experts,
+                mesh_stride, num_rows, topk, a.need_renorm, st);
+        (void)ok; // num_experts already fenced to an instantiated case
+    };
+
+    float ave_time = aiter::launch_kernel(s,
+                                          maybe_clear_workspace,
+                                          fused_softmax,
+                                          OPUS_MOE_SORTING_MP_1(uint8_t, 16, false, false),
+                                          OPUS_MOE_SORTING_MP_23(uint8_t, 16, false, false));
+    return ave_time;
+}
