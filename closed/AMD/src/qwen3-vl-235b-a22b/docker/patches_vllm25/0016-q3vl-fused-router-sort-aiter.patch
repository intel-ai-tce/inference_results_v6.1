+
+// Fusion campaign 2 - #3 (Alt C): fused router-softmax + opus sort.
+// Mirrors moe_sorting_opus_fwd but takes `gating` (router logits) instead of topk_ids
+// and computes softmax-top-k inside the sort. The caller (Python moe_sorting_fused)
+// applies an identical fence and only invokes this on the supported LARGE path; the
+// AITER_CHECK below is a belt-and-suspenders guard so a config drift never silently
+// corrupts routing.
+void moe_sorting_opus_fused_fwd(aiter_tensor_t& gating,
+                                aiter_tensor_t& topk_weights,
+                                aiter_tensor_t& sorted_token_ids,
+                                aiter_tensor_t& sorted_weights,
+                                aiter_tensor_t& sorted_expert_ids,
+                                aiter_tensor_t& num_valid_ids,
+                                aiter_tensor_t& moe_buf,
+                                int num_experts,
+                                int unit_size,
+                                int topk,
+                                bool need_renorm,
+                                std::optional<aiter_tensor_t> workspace,
+                                int dispatch_policy)
+{
+    AITER_CHECK(topk_weights.dtype() == AITER_DTYPE_fp32, "topk_weights must be FP32 (float32)");
+    AITER_CHECK(gating.dim() == 2, "gating must be 2D [tokens, num_experts]");
+    AITER_CHECK(gating.is_contiguous(), "gating must be contiguous");
+    AITER_CHECK(topk_weights.is_contiguous(), "topk_weights must be contiguous");
+
+    const int num_tokens = gating.size(0);
+    AITER_CHECK(gating.size(1) == num_experts, "gating last dim must equal num_experts");
+    AITER_CHECK(topk_weights.dim() == 2 && topk_weights.size(0) == num_tokens &&
+                    topk_weights.size(1) == topk,
+                "topk_weights must be [tokens, topk]");
+
+    const std::string gating_dtype = AiterDtype_to_str(gating.dtype());
+
+    HipDeviceGuard device_guard(gating.device_id);
+    const hipStream_t stream = aiter::getCurrentHIPStream();
+
+    void* ws_ptr = workspace.has_value() ? workspace.value().data_ptr() : nullptr;
+
+    moe_sorting_opus_args a{};
+    a.p_topk_ids              = nullptr;
+    a.p_weights               = topk_weights.data_ptr(); // written by fused kernel, read by P23
+    a.p_local_expert_mask     = nullptr;
+    a.p_local_tokens          = nullptr;
+    a.p_sorted_token_ids      = sorted_token_ids.data_ptr();
+    a.p_sorted_weights        = sorted_weights.data_ptr();
+    a.p_sorted_expert_ids     = sorted_expert_ids.data_ptr();
+    a.p_total_tokens_post_pad = num_valid_ids.data_ptr();
+    a.p_moe_buf               = moe_buf.data_ptr();
+    a.p_ws                    = ws_ptr;
+    a.p_local_topk_ids        = nullptr;
+    a.tokens                  = num_tokens;
+    a.unit_size               = unit_size;
+    a.num_experts             = num_experts;
+    a.topk                    = topk;
+    a.moe_buf_interm_dim      = static_cast<int>(moe_buf.size(-1));
+    a.moe_buf_elem_bytes      = static_cast<int>(moe_buf.element_size());
+    a.p_gating                = gating.data_ptr();
+    a.need_renorm             = need_renorm;
+
+    const float ret =
+        moe_sorting_opus_fused({"i32", "fp32", false, true, dispatch_policy}, a, gating_dtype,
+                               {stream});
+    AITER_CHECK(ret >= 0.0f,
+                "moe_sorting_opus_fused: unsupported configuration (fence rejected). "
+                "The caller must fall back to topk_softmax + moe_sorting_opus_fwd.");
+}
