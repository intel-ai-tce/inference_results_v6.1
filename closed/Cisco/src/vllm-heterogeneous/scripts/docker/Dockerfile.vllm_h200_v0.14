FROM nvidia/cuda@sha256:520292dbb4f755fd360766059e62956e9379485d9e073bbd2f6e3c20c270ed66

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG MAX_JOBS=16
ARG VLLM_REPOSITORY=https://github.com/vllm-project/vllm.git
ARG VLLM_REVISION=11b6af5280d6d6dfb8953af16e67b25f819b3be9
ARG VLLM_VERSION=0.14.0rc2.dev0+g11b6af528.d20260212.cu126
ARG PYTORCH_INDEX=https://download.pytorch.org/whl/cu128
ARG TORCH_VERSION=2.9.1+cu128
ARG TORCHVISION_VERSION=0.24.1+cu128
ARG TORCHAUDIO_VERSION=2.9.1+cu128
ARG TRITON_VERSION=3.5.1
ARG NIXL_VERSION=0.9.0
ARG OMEGACONF_VERSION=2.3.1
ARG MLPERF_LOADGEN_REPOSITORY=https://github.com/mlcommons/inference.git
ARG MLPERF_LOADGEN_TAG=v5.1.1
ARG MLPERF_LOADGEN_REVISION=6776245e99dce0600cfc9a6fb61efd310f87de3d
ARG TORCH_CUDA_ARCH_LIST=9.0a
ARG CMAKE_CUDA_ARCHITECTURES=90
ARG CMAKE_CUDA_FLAGS=-gencode arch=compute_90a,code=sm_90a

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/vllm-venv \
    PATH=/opt/vllm-venv/bin:$PATH \
    MAX_JOBS=${MAX_JOBS} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    CMAKE_CUDA_ARCHITECTURES=${CMAKE_CUDA_ARCHITECTURES} \
    CMAKE_CUDA_FLAGS=${CMAKE_CUDA_FLAGS} \
    VLLM_TARGET_DEVICE=cuda \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

USER root
WORKDIR /opt/mlperf-rebuild

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ccache cmake curl git libnuma-dev ninja-build pkg-config \
        python3-dev python3-pip python3-venv \
    && python3 -m venv "$VIRTUAL_ENV" \
    && python -m pip install --upgrade \
        "pip<27" "setuptools>=77,<81" "setuptools-rust" "setuptools-scm" wheel "pybind11==3.0.1" \
    && rm -rf /var/lib/apt/lists/*

RUN printf "%s\n" "torch==${TORCH_VERSION}" "triton==${TRITON_VERSION}" \
        > /tmp/pip-constraints.txt \
    && python -m pip install --extra-index-url "${PYTORCH_INDEX}" \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}" \
        "torchaudio==${TORCHAUDIO_VERSION}"

RUN git clone --depth=1 --branch "${MLPERF_LOADGEN_TAG}" "${MLPERF_LOADGEN_REPOSITORY}" /opt/mlperf-rebuild/mlperf-inference \
    && test "$(git -C /opt/mlperf-rebuild/mlperf-inference rev-parse HEAD)" = "${MLPERF_LOADGEN_REVISION}" \
    && python -m pip install --no-build-isolation /opt/mlperf-rebuild/mlperf-inference/loadgen \
    && rm -rf /opt/mlperf-rebuild/mlperf-inference

RUN git clone --filter=blob:none --no-checkout "$VLLM_REPOSITORY" /opt/mlperf-rebuild/vllm \
    && git -C /opt/mlperf-rebuild/vllm checkout --detach "$VLLM_REVISION" \
    && cd /opt/mlperf-rebuild/vllm \
    && python -m pip install --extra-index-url "${PYTORCH_INDEX}" \
        --constraint /tmp/pip-constraints.txt -r requirements/cuda.txt \
    && python -m pip install --extra-index-url "${PYTORCH_INDEX}" \
        --constraint /tmp/pip-constraints.txt "nixl-cu12==${NIXL_VERSION}" \
    && SETUPTOOLS_SCM_PRETEND_VERSION="${VLLM_VERSION}" \
        MAX_JOBS="${MAX_JOBS}" \
        CMAKE_BUILD_PARALLEL_LEVEL="${MAX_JOBS}" \
        CMAKE_CUDA_FLAGS="${CMAKE_CUDA_FLAGS}" \
        VLLM_TARGET_DEVICE=cuda \
        python setup.py bdist_wheel --dist-dir=/tmp/vllm-wheel \
    && python -m pip install --force-reinstall --no-deps /tmp/vllm-wheel/vllm-*.whl

RUN python -m pip install --no-cache-dir "omegaconf==${OMEGACONF_VERSION}"

RUN TORCH_EXPECT="${TORCH_VERSION}" TRITON_EXPECT="${TRITON_VERSION}" NIXL_EXPECT="${NIXL_VERSION}" VLLM_EXPECT="${VLLM_VERSION}" OMEGACONF_EXPECT="${OMEGACONF_VERSION}" LOADGEN_EXPECT="5.1.1" MLPERF_LOADGEN_TAG="${MLPERF_LOADGEN_TAG}" python -c 'import importlib.metadata as metadata, os, omegaconf, pybind11, torch, triton, vllm; assert torch.__version__ == os.environ["TORCH_EXPECT"], torch.__version__; assert torch.version.cuda == "12.8", torch.version.cuda; assert triton.__version__ == os.environ["TRITON_EXPECT"], triton.__version__; assert metadata.version("nixl-cu12") == os.environ["NIXL_EXPECT"]; assert vllm.__version__ == os.environ["VLLM_EXPECT"], vllm.__version__; assert metadata.version("pybind11") == "3.0.1"; assert metadata.version("mlcommons_loadgen") == os.environ["LOADGEN_EXPECT"]; assert metadata.version("omegaconf") == os.environ["OMEGACONF_EXPECT"]; print("vllm=" + vllm.__version__ + " torch=" + torch.__version__ + " cuda=" + str(torch.version.cuda) + " triton=" + triton.__version__ + " nixl=" + metadata.version("nixl-cu12") + " pybind11=" + metadata.version("pybind11") + " omegaconf=" + metadata.version("omegaconf") + " mlcommons_loadgen=" + metadata.version("mlcommons_loadgen") + " mlperf_loadgen_source=" + os.environ["MLPERF_LOADGEN_TAG"])'

# Proxies may be injected by a build host, but no endpoint is retained in the
# shipped image.
ENV HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY= http_proxy= https_proxy= all_proxy= no_proxy=

WORKDIR /inference
ENTRYPOINT []
CMD ["sleep", "infinity"]
