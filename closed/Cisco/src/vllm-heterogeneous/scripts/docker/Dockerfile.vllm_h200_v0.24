FROM nvidia/cuda@sha256:020bc241a628776338f4d4053fed4c38f6f7f3d7eb5919fecb8de313bb8ba47c

SHELL ["/bin/bash", "-o", "pipefail", "-c"]


ARG VLLM_SOURCE_SHA256=286571b02164190fd6c5bf86410c7643d5eac8a7dff5d868641b92969c4c2f60
ARG MAX_JOBS=16
ARG TORCH_CUDA_ARCH_LIST=9.0a
ARG CMAKE_CUDA_ARCHITECTURES=90
ARG PYTORCH_INDEX=https://download.pytorch.org/whl/cu129
ARG OMEGACONF_VERSION=2.3.1
ARG PYBIND11_VERSION=3.0.1
ARG MLPERF_LOADGEN_REPOSITORY=https://github.com/mlcommons/inference.git
ARG MLPERF_LOADGEN_TAG=v5.1.1
ARG MLPERF_LOADGEN_VERSION=5.1.1
ARG MLPERF_LOADGEN_REVISION=6776245e99dce0600cfc9a6fb61efd310f87de3d

ENV DEBIAN_FRONTEND=noninteractive \
    MAX_JOBS=${MAX_JOBS} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    CMAKE_CUDA_ARCHITECTURES=${CMAKE_CUDA_ARCHITECTURES} \
    VLLM_TARGET_DEVICE=cuda \
    VIRTUAL_ENV=/opt/vllm-venv \
    PATH=/opt/vllm-venv/bin:${PATH}

USER root
WORKDIR /opt/mlperf-rebuild

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ccache cmake curl git libnuma-dev ninja-build pkg-config \
      python3-dev python3-pip python3-venv \
 && python3 -m venv "${VIRTUAL_ENV}" \
 && python -m pip install --no-cache-dir --upgrade \
      "pip<27" "setuptools==80.10.2" "setuptools-rust" "setuptools-scm" "wheel==0.47.0" \
 && rm -rf /var/lib/apt/lists/*

COPY artifacts/src/vllm-v0.24.0.tar.gz /tmp/source-archives/vllm-v0.24.0.tar.gz
RUN echo "${VLLM_SOURCE_SHA256}  /tmp/source-archives/vllm-v0.24.0.tar.gz" | sha256sum -c - \
 && mkdir -p /opt/mlperf-rebuild/vllm \
 && tar -xzf /tmp/source-archives/vllm-v0.24.0.tar.gz \
      --strip-components=1 -C /opt/mlperf-rebuild/vllm

RUN printf "%s\n" "torch==2.11.0+cu129" > /tmp/pip-constraints.txt \
 && python -m pip install --no-cache-dir --extra-index-url "${PYTORCH_INDEX}" \
      "torch==2.11.0+cu129" "torchaudio==2.11.0+cu129" "torchvision==0.26.0+cu129" \
 && cd /opt/mlperf-rebuild/vllm \
 && python -m pip install --no-cache-dir --extra-index-url "${PYTORCH_INDEX}" --constraint /tmp/pip-constraints.txt -r requirements/cuda.txt \
 && python -m pip install --no-cache-dir --extra-index-url "${PYTORCH_INDEX}" --constraint /tmp/pip-constraints.txt \
      "compressed-tensors==0.17.0" "flashinfer-python==0.6.12" \
      "msgpack==1.2.1" "nixl-cu12==0.9.0" "nltk==3.9.4" \
      "omegaconf==2.3.1" "pandas==3.0.3" "rouge-score==0.1.2" \
      "transformers==5.12.1" "triton==3.6.0"

RUN cd /opt/mlperf-rebuild/vllm \
 && SETUPTOOLS_SCM_PRETEND_VERSION=0.24.0+cu129 \
      CMAKE_BUILD_PARALLEL_LEVEL="${MAX_JOBS}" \
      python -m pip wheel --no-build-isolation --no-deps --wheel-dir=/tmp/vllm-wheel . \
 && python -m pip install --force-reinstall --no-deps --no-cache-dir /tmp/vllm-wheel/vllm-*.whl

RUN python -m pip install --no-cache-dir "pybind11==${PYBIND11_VERSION}" \
 && git clone --depth=1 --branch "${MLPERF_LOADGEN_TAG}" "${MLPERF_LOADGEN_REPOSITORY}" /opt/mlperf-rebuild/mlperf-inference \
 && test "$(git -C /opt/mlperf-rebuild/mlperf-inference rev-parse HEAD)" = "${MLPERF_LOADGEN_REVISION}" \
 && python -m pip install --no-cache-dir --no-build-isolation /opt/mlperf-rebuild/mlperf-inference/loadgen \
 && rm -rf /opt/mlperf-rebuild/mlperf-inference

RUN PYBIND11_EXPECT="${PYBIND11_VERSION}" LOADGEN_EXPECT="${MLPERF_LOADGEN_VERSION}" python -c 'import importlib.metadata as m, os; expected={"pybind11":os.environ["PYBIND11_EXPECT"], "mlcommons_loadgen":os.environ["LOADGEN_EXPECT"], "torch":"2.11.0+cu129", "triton":"3.6.0", "transformers":"5.12.1", "flashinfer-python":"0.6.12", "nixl-cu12":"0.9.0", "compressed-tensors":"0.17.0", "msgpack":"1.2.1", "omegaconf":"2.3.1", "pandas":"3.0.3", "rouge-score":"0.1.2", "nltk":"3.9.4"}; actual={k:m.version(k) for k in expected}; print(actual); assert actual == expected, (actual, expected)' \
 && python -c 'import mlperf_loadgen, omegaconf, pybind11, torch, vllm; assert torch.version.cuda == "12.9", torch.version.cuda; assert vllm.__version__.split("+")[0] == "0.24.0", vllm.__version__'

ENV HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy=

WORKDIR /inference
ENTRYPOINT []
CMD ["sleep", "infinity"]
