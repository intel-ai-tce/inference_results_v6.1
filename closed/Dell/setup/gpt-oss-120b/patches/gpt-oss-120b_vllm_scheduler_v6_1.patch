+    def _should_admit_waiting(self) -> bool:
+        # Only makes sense to *delay* prefills if we have decode work to keep
+        # the GPU busy in the meantime. With an empty running set, admit
+        # immediately (delaying would just idle the GPU and hurt everything).
+        if not self.running:
+            return True
+
+        num_waiting = len(self.waiting) + len(self.skipped_waiting)
+        if num_waiting == 0:
+            return False
+
+        # TODO: force-admit once we have accumulated a full-enough prefill
+        # batch, before the delay budget elapses (see `prefill_batch_min_reqs`
+        # TODO in __init__):
+        #     if num_waiting >= self.prefill_batch_min_reqs:
+        #         return True
+
+        # Otherwise, admit once the oldest waiting request nears the TTFT budget.
+        # NOTE: `Request.arrival_time` is wall-clock (`time.time()`), so the
+        # comparison must use the same clock. Using `time.monotonic()` here
+        # would make `max_wait` a large negative value and never admit while
+        # any request is running.
+        now = time.time()
+        oldest = self.waiting.peek_request() if self.waiting else None
+        skipped = self.skipped_waiting.peek_request() if self.skipped_waiting else None
+        candidates = [r for r in (oldest, skipped) if r is not None]
+        max_wait = max(now - r.arrival_time for r in candidates)
+        return max_wait >= self.prefill_max_queue_delay_s
+
