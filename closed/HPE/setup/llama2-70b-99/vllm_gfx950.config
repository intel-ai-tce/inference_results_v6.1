# Build-time aiter/Triton kernel preload disabled: full LLM engine init during
# docker build exhausts host RAM on the CI runner (OOM/SIGKILL, exit 137).
# Kernels are warmed at runtime instead via HARNESS_PRELOAD_AITER_KERNELS before
# the engine reserves VRAM (see code/harness_llm/backends/common/preload_triton_cache.py).
export PRELOAD_AITER_COMMAND_ARGS=""
