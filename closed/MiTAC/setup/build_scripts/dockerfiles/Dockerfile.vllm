ARG BASE_IMAGE
FROM $BASE_IMAGE

ARG DEBIAN_FRONTEND=noninteractive
ARG VLLM_DIR=setup/vllm
ARG GPU_ARCH
ENV GPU_TARGETS=${GPU_ARCH}

# Re-install vllm
COPY ${VLLM_DIR} /lab-mlperf-inference/vllm
RUN cd /lab-mlperf-inference/vllm \
    && python3 -m pip uninstall -y vllm \
    && rm -rf /app/vllm/ \
    && rm -rf /root/.cache/vllm/ \
    && python3 -m pip install --upgrade setuptools setuptools_rust wheel \
    && python3 setup.py clean --all  \
    && python3 -m pip install -r requirements/rocm.txt \
    && SCCACHE_IDLE_TIMEOUT=1800 python3 setup.py develop

# Torch profiler compatibility
RUN rm /opt/rocm/lib/libamdhip64.so.7 && ln -s /opt/rocm/lib/libamdhip64.so.7.2.53211-35e8c7bf89 /opt/rocm/lib/libamdhip64.so.7

WORKDIR /lab-mlperf-inference/submission/
