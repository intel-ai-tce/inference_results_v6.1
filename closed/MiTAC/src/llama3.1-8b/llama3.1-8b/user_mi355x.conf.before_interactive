# The format of this config file is 'key = value'.
# The key has the format 'model.scenario.key'. Value is mostly int64_t.
# Model maybe '*' as wildcard. In that case the value applies to all models.
# All times are in milli seconds
#

# LLAMA3.1-8b
# v6.1 Closed requires a >=600s min test duration for a VALID performance run.
# Server/Interactive honor min_duration directly (LoadGen streams for the full
# duration at target_qps). Offline duration in THIS harness is set by the query
# count (offline_mi355x.yaml total_sample_count=802080 -> ~657s), not by
# min_duration; the 600000 below is kept only for consistency/safety.
llama3_1-8b.Offline.min_duration = 600000
llama3_1-8b.Server.min_duration = 600000
# 600s run at qps=1175 was INVALID: TPOT p99=114.5ms (>100ms limit), mean 92.6ms.
# Lowered to 1160 for the long run (may need further reduction if TPOT p99 stays >100ms).
llama3_1-8b.Server.target_qps = 1180

# LLAMA3.1-8b Interactive
llama3_1-8b-interactive.Offline.min_duration = 600000
llama3_1-8b-interactive.Server.min_duration = 600000
# Max QPS that keeps TTFT p99<=500ms and TPOT p99<=30ms (VALID).
# History: 790 (stock) -> 810 with prefill-tokens-per-step cap
# (VLLM_MAX_PREFILL_TOKENS_PER_STEP, now 6144) -> ~900 proven VALID.
# Then prefill-AWARE routing (schedule_algo=shortest_queue_prefill,
# prefill_backlog_weight=8 in interactive_mi355x.yaml) cut TTFT p99 445->192ms at
# qps900 and flipped the workload to TPOT-bound. New ceiling ~1000-1020:
#   qps900 : TTFT p99 192ms / TPOT p99 18ms  VALID (big margin)
#   qps1050: TTFT p99 371ms / TPOT p99 31.5ms INVALID (TPOT over, TTFT fine)
# 1000 is the initial trial point (interpolated TPOT ~27ms, expected VALID but
# tight -- VERIFY). Proven-safe fallback = 900.
llama3_1-8b-interactive.Server.target_qps = 1020
